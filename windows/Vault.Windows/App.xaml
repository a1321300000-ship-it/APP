<Application x:Class="Vault.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFE8ECE7"/>
            <Setter Property="Background" Value="#FF1A1D1D"/>
            <Setter Property="BorderBrush" Value="#99FF1744"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1A1D1D"/>
            <Setter Property="Foreground" Value="#FFE8ECE7"/>
            <Setter Property="BorderBrush" Value="#553F4542"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF1A1D1D"/>
            <Setter Property="Foreground" Value="#FFE8ECE7"/>
            <Setter Property="BorderBrush" Value="#553F4542"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8ECE7"/>
            <Setter Property="Margin" Value="6,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1A1D1D"/>
            <Setter Property="Foreground" Value="#FFE8ECE7"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Application.Resources>
</Application>